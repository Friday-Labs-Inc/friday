 "fields": [
  {
   "description": "The backend's event UUID \u2014 the idempotency key. Unique: a duplicate delivery cannot create a second row.",
   "fieldname": "event_id",
   "fieldtype": "Data",
   "in_list_view": 1,
   "label": "Event ID",
   "reqd": 1,
   "unique": 1
  },
  {
   "description": "Envelope type, e.g. project.created, gate.decided.",
   "fieldname": "event_type",
   "fieldtype": "Data",
   "in_list_view": 1,
   "label": "Event Type",
   "reqd": 1
  },
  {
   "fieldname": "version",
   "fieldtype": "Data",
   "label": "Version"
  },
  {
   "description": "The backend's occurred_at timestamp (informational; signature freshness uses the per-attempt t).",
   "fieldname": "occurred_at",
   "fieldtype": "Data",
   "label": "Occurred At"
  },
  {
   "default": "Received",
   "description": "Received = persisted + queued. Processed = handler succeeded. Failed = handler errored (failure_reason set); a backend replay re-runs it.",
   "fieldname": "status",
   "fieldtype": "Select",
   "in_list_view": 1,
   "label": "Status",
   "options": "Received\nProcessed\nFailed"
  },
  {
   "description": "The full envelope `data` object, verbatim.",
   "fieldname": "payload",
   "fieldtype": "JSON",
   "label": "Payload"
  },
  {
   "fieldname": "failure_reason",
   "fieldtype": "Small Text",
   "label": "Failure Reason"
  },
  {
   "fieldname": "processed_at",
   "fieldtype": "Datetime",
   "label": "Processed At"
  },
  {
   "default": "0",
   "description": "Reconciler-issued retries of process_event for events stuck Received or Failed. Capped at 3; beyond that the event stays Failed for a human (or a backend replay with a fresh signature).",
   "fieldname": "retry_count",
   "fieldtype": "Int",
   "label": "Retry Count",
   "read_only": 1
  }
 ],
