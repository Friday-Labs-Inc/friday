{
 "actions": [],
 "allow_rename": 1,
 "autoname": "field:project_name",
 "doctype": "DocType",
 "engine": "InnoDB",
 "field_order": [
  "project_name",
  "description",
  "status",
  "priority",
  "project_lead_profile",
  "backend_ref",
  "planning_section",
  "expected_start_date",
  "expected_end_date",
  "actual_start_date",
  "actual_end_date",
  "conversation_channel",
  "rollup_section",
  "percent_complete",
  "total_tasks",
  "completed_tasks",
  "estimated_cost_usd",
  "actual_cost_usd"
 ],
 "fields": [
  {
   "fieldname": "project_name",
   "fieldtype": "Data",
   "in_list_view": 1,
   "label": "Project Name",
   "reqd": 1,
   "unique": 1
  },
  {
   "fieldname": "description",
   "fieldtype": "Long Text",
   "label": "Description"
  },
  {
   "fieldname": "status",
   "fieldtype": "Select",
   "in_list_view": 1,
   "label": "Status",
   "options": "Open\nIn Progress\nCompleted\nCancelled\nOn Hold",
   "reqd": 1
  },
  {
   "description": "The external backend's project id (write-back + event linkage).",
   "fieldname": "backend_ref",
   "fieldtype": "Data",
   "label": "Backend Ref",
   "unique": 1
  },
  {
   "default": "Medium",
   "fieldname": "priority",
   "fieldtype": "Select",
   "label": "Priority",
   "options": "Low\nMedium\nHigh\nUrgent"
  },
  {
   "description": "The commander/orchestrator agent leading this project.",
   "fieldname": "project_lead_profile",
   "fieldtype": "Link",
   "label": "Project Lead",
   "options": "Agent Profile"
  },
  {
   "fieldname": "planning_section",
   "fieldtype": "Section Break",
   "label": "Planning"
  },
  {
   "fieldname": "expected_start_date",
   "fieldtype": "Date",
   "label": "Expected Start Date"
  },
  {
   "fieldname": "expected_end_date",
   "fieldtype": "Date",
   "label": "Expected End Date"
  },
  {
   "description": "Earliest task start (derived).",
   "fieldname": "actual_start_date",
   "fieldtype": "Date",
   "label": "Actual Start Date",
   "read_only": 1
  },
  {
   "description": "Latest task completion once all tasks are terminal (derived).",
   "fieldname": "actual_end_date",
   "fieldtype": "Date",
   "label": "Actual End Date",
   "read_only": 1
  },
  {
   "description": "The dedicated Raven channel for this project's team conversation (Design 73). Auto-provisioned on creation. Stored as the channel docname (Data, not Link, so friday_core stays installable without Raven).",
   "fieldname": "conversation_channel",
   "fieldtype": "Data",
   "label": "Conversation Channel",
   "read_only": 1
  },
  {
   "fieldname": "rollup_section",
   "fieldtype": "Section Break",
   "label": "Progress & Cost"
  },
  {
   "description": "completed_tasks / total_tasks (derived; design 65d).",
   "fieldname": "percent_complete",
   "fieldtype": "Percent",
   "label": "% Complete",
   "read_only": 1
  },
  {
   "fieldname": "total_tasks",
   "fieldtype": "Int",
   "label": "Total Tasks",
   "read_only": 1
  },
  {
   "fieldname": "completed_tasks",
   "fieldtype": "Int",
   "label": "Completed Tasks",
   "read_only": 1
  },
  {
   "description": "Estimated LLM spend rolled up from child tasks (design 65d).",
   "fieldname": "estimated_cost_usd",
   "fieldtype": "Currency",
   "label": "Estimated Cost (USD)",
   "options": "USD",
   "read_only": 1
  },
  {
   "description": "Actual LLM spend rolled up from child tasks (design 65d).",
   "fieldname": "actual_cost_usd",
   "fieldtype": "Currency",
   "label": "Actual Cost (USD)",
   "options": "USD",
   "read_only": 1
  }
 ],
 "links": [],
 "module": "Friday Core",
 "name": "Project",
 "naming_rule": "Set by user",
 "permissions": [
  {
   "create": 1,
   "delete": 1,
   "read": 1,
   "role": "System Manager",
   "write": 1
  },
  {
   "create": 1,
   "read": 1,
   "role": "Agent Supervisor",
   "write": 1
  }
 ],
 "sort_field": "creation",
 "sort_order": "DESC",
 "states": [],
 "track_changes": 1
}
