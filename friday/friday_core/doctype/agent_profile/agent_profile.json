    "fields": [
        {
            "fieldname": "profile_name",
            "fieldtype": "Data",
            "in_list_view": 1,
            "label": "Profile Name",
            "reqd": 1,
            "unique": 1
        },
        {
            "default": "Specialist",
            "description": "The agent's role in the system (design 68). Orchestrators plan and delegate. Specialists go deep in one domain. Workers execute one narrow task precisely. The role drives the prompt frame, default approval threshold, and (for Orchestrators) a default read-tool seed on first insert.",
            "fieldname": "agent_role",
            "fieldtype": "Select",
            "in_list_view": 1,
            "label": "Agent Role",
            "options": "Orchestrator\nSpecialist\nWorker",
            "reqd": 1
        },
        {
            "description": "Design 75 routing key. The Role this profile answers for when the engine routes a workflow transition: the engine matches a Friday Workflow Transition Meta's agent_role to the active profile whose discriminator_role equals it (O(1) lookup, replaces skill-subset discrimination). At most one Active profile may hold a given discriminator_role (enforced at save) so a misconfigured second profile fails loudly, not silently-dead.",
            "fieldname": "discriminator_role",
            "fieldtype": "Link",
            "label": "Discriminator Role",
            "options": "Role"
        },
        {
            "description": "The Domain Bundle that provisioned this profile (Design 75). Lets a bundle export/import gather its own profiles. Empty for profiles created outside a bundle.",
            "fieldname": "domain_bundle",
            "fieldtype": "Link",
            "label": "Domain Bundle",
            "options": "Domain Bundle"
        },
        {
            "fieldname": "description",
            "fieldtype": "Text",
            "label": "Description"
        },
        {
            "fieldname": "assigned_roles",
            "fieldtype": "Table",
            "label": "Assigned Roles",
            "options": "Has Role"
        },
        {
            "fieldname": "model_provider",
            "fieldtype": "Link",
            "label": "Model Provider",
            "options": "LLM Provider"
        },
        {
            "fieldname": "model_name",
            "fieldtype": "Data",
            "label": "Model Name"
        },
        {
            "fieldname": "system_prompt",
            "fieldtype": "Long Text",
            "label": "System Prompt"
        },
        {
            "fieldname": "permitted_skills",
            "fieldtype": "Table",
            "label": "Permitted Skills",
            "options": "Agent Profile Skill"
        },
        {
            "fieldname": "network_allowlist",
            "fieldtype": "Small Text",
            "label": "Network Allowlist"
        },
        {
            "fieldname": "requires_approval_above_risk",
            "fieldtype": "Select",
            "label": "Requires Approval Above Risk",
            "options": "low\nmedium\nhigh\nalways"
        },
        {
            "default": "5",
            "description": "Maximum active delegated children this profile can have running at once (design 69, Q10). Prevents one runaway orchestrator from flooding the friday queue.",
            "fieldname": "max_concurrent_delegations",
            "fieldtype": "Int",
            "label": "Max Concurrent Delegations"
        },
        {
            "fieldname": "status",
            "fieldtype": "Select",
            "in_list_view": 1,
            "label": "Status",
            "options": "Active\nSuspended\nRetired",
            "reqd": 1
        },
        {
            "description": "The backing system Frappe User for this agent (design 65a). Auto-provisioned, login disabled. Lets the agent be assigned, @-mentioned, and shown with an avatar in Desk.",
            "fieldname": "frappe_user",
            "fieldtype": "Link",
            "label": "Frappe User",
            "options": "User",
            "read_only": 1
        }
